# S-360 — bulutta sadece DATABASE_URL yeterli.
# İlk start otomatik kurulum yapar; sonraki start’lar sadece günceller.

PORT=3600
DATABASE_URL=postgresql://s360:s360local@127.0.0.1:5432/s360
NODE_ENV=production

# İsteğe bağlı (yoksa otomatik üretilir / varsayılan kullanılır)
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@s360.local
ADMIN_USER=admin
ADMIN_PASS=Admin123!

# Production’da Postgres zorunlu olsun (Railway’de genelde NODE_ENV=production yeter)
# REQUIRE_POSTGRES=1
