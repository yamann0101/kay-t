# S-360 — kayıtlar yalnızca PostgreSQL’de.
# DATABASE_URL zorunlu. Yerel dosya veritabanı kullanılmaz.

PORT=3600
DATABASE_URL=postgresql://s360:s360local@127.0.0.1:5432/s360
NODE_ENV=production

# İsteğe bağlı
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@s360.local
ADMIN_USER=admin
ADMIN_PASS=Admin123!
